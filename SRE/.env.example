# ═══════════════════════════════════════════
# Ops Factory Environment Variables
# Copy to .env only when you need overrides.
# The default model is the bundled local Qwen-0.6B service.
# ═══════════════════════════════════════════

# ── Model ──
# Leave these unset for local Qwen-0.6B.
# LLM_PROVIDER=local
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# LLM_MODEL=Qwen/Qwen3-0.6B
#
# Optional user-supplied API mode can also be selected in the dashboard.
# Ops Factory does not ship or provide any API key.
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
# LLM_MODEL=your-model-name
# LLM_API_KEY=your-own-key

# ── Kubernetes ──
# SSH jump host for K8s access (default in config.yaml)
# K8S_SSH_JUMP=openstack@222.200.180.102
# K8S_SSH_TARGET=ubuntu@10.10.3.110

# ── Observability Stack ──
# PROMETHEUS_URL=http://localhost:9090
# ELASTICSEARCH_URL=http://localhost:9200
# JAEGER_URL=http://localhost:16686

# ── ChromaDB ──
# CHROMA_PERSIST_DIR=./data/chroma

# ── Web Dashboard ──
# WEB_PORT=8080
